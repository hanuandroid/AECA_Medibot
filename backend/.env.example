# Copy to backend/.env and fill in. Never commit backend/.env.

# ---- LLM (cloud inference API) -------------------------------------------------------------
# LLM_PROVIDER: openai | groq | gemini | openrouter | anthropic
#   (openai also works with any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL=
# Provider-specific variables are also honoured: OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY
# Examples:
#   LLM_PROVIDER=groq       LLM_MODEL=llama-3.3-70b-versatile
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-haiku-4-5-20251001
#   LLM_PROVIDER=gemini     LLM_MODEL=gemini-2.5-flash

# ---- Auth -----------------------------------------------------------------------------------
# At least 32 characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRY_MINUTES=480
# Demo accounts (development only). Either one shared password for the 5 demo users...
DEMO_PASSWORD=change-me
# ...or explicit entries username:role:password separated by ';' (overrides DEMO_PASSWORD)
# DEMO_USERS=dr.mehta:doctor:pw1;nurse.priya:nurse:pw2;billing.ravi:billing_executive:pw3;tech.anand:technician:pw4;admin.sys:admin:pw5

# ---- Qdrant ---------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Use Qdrant's embedded local engine instead of a server (no Docker needed):
# QDRANT_PATH=./data/qdrant_local
QDRANT_COLLECTION=medibot_chunks

# ---- Retrieval ------------------------------------------------------------------------------
RETRIEVAL_CANDIDATES=10
PREFETCH_LIMIT=30
RERANK_TOP_K=3
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=jinaai/jina-reranker-v1-turbo-en
CHUNK_MAX_TOKENS=384

# ---- SQL RAG --------------------------------------------------------------------------------
# Relative dates ("last month") resolve against this date. Empty = latest date in the DB.
SQL_AS_OF_DATE=
SQL_MAX_ROWS=200

# ---- API ------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WARMUP_MODELS=true
